# Configuration for Job Application Automation & Reply Monitor

# Gmail address for sending applications and checking replies
GMAIL_USER="prajwathg@gmail.com"

# 16-character Google App Password (generated via Google Account -> Security -> 2-Step Verification -> App Passwords)
GMAIL_APP_PASSWORD="your-16-char-app-password"

# Optional: phone push for positive replies via ntfy.sh. Pick a long random topic name,
# subscribe to it in the ntfy app on your phone. Leave empty to disable.
NTFY_TOPIC=""

# Commit and push job_applications.csv after each scan so the live dashboard updates.
# The repo is public, so reply statuses become public. Set to "false" to turn off.
AUTO_PUSH="true"

# AI key for the auto_apply.py form agent (answers dropdowns and custom questions). Set one.
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# Optional when both are set: "gemini" or "claude"
AI_PROVIDER=""

# LinkedIn daily step runs only after a browser login has been saved.
# Set false to disable it. No LinkedIn password belongs in this file.
LINKEDIN_ENABLED="true"
# Optional custom browser profile directory; otherwise reuse the existing
# ~/.config/job-tracker-linkedin profile, or create .linkedin-profile locally.
LINKEDIN_PROFILE_DIR=""
